# PostgreSQL connection string (Neon / Supabase / RDS / local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/she_courses"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Public URL of the app (used for callbacks, certificate verification links)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Google sign-in (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Razorpay (https://dashboard.razorpay.com/app/keys) — use rzp_test_ keys while testing
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
